    "def livedata():\n",
    "    # Apply nest_asyncio to avoid \"event loop already running\" errors\n",
    "    nest_asyncio.apply()\n",
    "    instruments = [(marketfeed.NSE, \"1333\", marketfeed.Quote)]\n",
    "\n",
    "    async def main():\n",
    "        try:\n",
    "            data = mf.DhanFeed(client_id=client_id,\n",
    "                               access_token=access_token,\n",
    "                               instruments=instruments)\n",
    "\n",
    "            # Await connection\n",
    "            await data.connect()\n",
    "            print('Connected to WebSocket')\n",
    "\n",
    "            # Process real-time data\n",
    "            while True:\n",
    "                data.run_forever()  # Await this if it's asynchronous\n",
    "                response =  data.get_data()  # Await if this is asynchronous\n",
    "                if response:\n",
    "                    print('Data Received ',response)\n",
    "                else:\n",
    "                    print('No data Received')\n",
    "                print(response)\n",
    "\n",
    "        except Exception as e:\n",
    "            print(e)\n",
    "\n",
    "    # Run the event loop\n",
    "    asyncio.run(main())\n"
   ]
