    "            df=pd.concat([df,temp],ignore_index=True)\n",
    "            print(df[-1:])\n",
    "\n",
    "    except Exception as e:\n",
    "        print(f\"Error:{e}\")\n",
    "\n",
    "    # Run the event loop\n",
    "asyncio.run(main())\n"
